{
  "name": "agent-pigeon-workspace",
  "version": "2.0.0-dev.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "agent-pigeon-workspace",
      "version": "2.0.0-dev.0",
      "workspaces": [
        "packages/core",
        "packages/cli"
      ],
      "engines": {
        "node": ">=22.13.0"
      }
    },
    "node_modules/@agent-pigeon/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/agent-pigeon": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "agent-pigeon",
      "version": "2.0.0-dev.0",
      "dependencies": {
        "@agent-pigeon/core": "2.0.0-dev.0"
      },
      "bin": {
        "agent-pigeon": "src/index.mjs",
        "pigeon": "src/index.mjs"
      },
      "engines": {
        "node": ">=22.13.0"
      }
    },
    "packages/core": {
      "name": "@agent-pigeon/core",
      "version": "2.0.0-dev.0",
      "engines": {
        "node": ">=22.13.0"
      }
    }
  }
}
